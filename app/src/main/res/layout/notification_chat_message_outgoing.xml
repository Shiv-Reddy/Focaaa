<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    android:gravity="end"
    android:orientation="horizontal">

    <TextView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_notification_chat_sent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/notification_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="290dp"
            android:textColor="@color/focaaa_chat_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/notification_message_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingTop="1dp"
            android:textColor="@color/focaaa_chat_meta"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
